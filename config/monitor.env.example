SNS_TOPIC_ARN=YOUR_SNS_TOPIC_ARN
AWS_PROFILE=election-backup
AWS_DEFAULT_REGION=us-east-2
DEPLOYMENT=election-production
DASHBOARD_URL=http://127.0.0.1:8000/api/snapshot
REQUIRE_PUBLICATION=true
MAX_RUN_AGE_SECONDS=900
# Backups run every six hours and take about half an hour.
MAX_BACKUP_AGE_SECONDS=25200
REMINDER_SECONDS=1800
# Overdue manual snapshots: a separate REMINDER message, repeated this often.
MANUAL_REMINDER_SECONDS=21600
MIN_FREE_DISK_PERCENT=15
DISK_PATHS=/
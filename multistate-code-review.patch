+                    totals = [a + b for a, b in zip(totals, measures)]
+        calculated = {}
+        for key, measures in county.items():
+            pair = key[3:]
+            combined = calculated.setdefault(pair, [0, 0, 0])
+            for i, value in enumerate(measures):
+                combined[i] += value

+                count += 1
+                if count > settings.max_csv_rows:
+                    raise ValueError("Kentucky results exceed the row budget")
+                row = dict(
+                    zip(
+                        FIELDS,
+                        (
+                            count + 1,
+                            source.election_date,
+                            source.state,
+                            raw["ReportingUnitId"],
+                            kind,
+                            name,
+                            precinct,
+                            selected[raw["ContestId"]],
+                            candidate["BallotName"],
+                            parties[party]["Abbreviation"] if party != "0" else "",
+                            day,
+                            total - day,
+                            total,
+                        ),
+                    )
+                )

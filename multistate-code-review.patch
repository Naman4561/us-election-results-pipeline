+                        raise ValueError("Duplicate statewide candidate total")
+                    official[pair] = measures
+                elif kind == "county":
+                    key = (source.election_date, source.state, name, *pair)
+                    if key in county:
+                        raise ValueError("Duplicate county candidate total")

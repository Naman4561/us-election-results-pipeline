+      choice: B
+      choice_party: REP
+      total_votes: 7
+    - release_id: 1
+      source_id: fl_2026_general
+      election_date: '2026-11-03'
+      state: FL
+      unit_type: state
+      county: ''
+      contest_id: FL-GOV
+      choice: C
+      choice_party: REP
+      total_votes: 20

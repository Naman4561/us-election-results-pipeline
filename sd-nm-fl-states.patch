+"""Strict readers for the ASP.NET election-night platform used by SD, NM (and NE).
+
+The statewide CSV, the results pages and the county workbooks are all official output
+of one state site. Nothing here infers a missing value: unknown means rejection, or,
+only where a sheet explicitly prints ``*``, "not reported".
+"""
+
+import csv
+import io
+import re
+
+from election_pipeline.parsers.html import Tree
+from election_pipeline.parsers.structured import count
+
+POSTBACK = re.compile(r"__doPostBack\('(ctl00\$MainContent\$[A-Za-z0-9_$]+)',''\)")
+
+
+def read_csv(raw, header, label):
+    text = raw.decode("utf-8-sig")
+    if "\x00" in text:
+        raise ValueError(f"{label} CSV contains NUL bytes")
+    reader = csv.reader(io.StringIO(text), strict=True)
+    if next(reader, []) != header:
+        raise ValueError(f"Unexpected {label} CSV header")
+    for line, values in enumerate(reader, 2):
+        if len(values) == len(header) + 1 and values[-1] == "":
+            values.pop()
+        if len(values) != len(header) or line > 100_000:
+            raise ValueError(f"Unexpected {label} field count/row limit")
+        values = dict(zip(header, (v.strip() for v in values)))
+        for field in ("RaceID", "CandidateID", "CandidateVotes"):
+            if not re.fullmatch(r"[0-9]+", values[field]):
+                raise ValueError(f"{label} {field} must be a nonnegative integer")
+        yield line, values
+
+
+def text(node):
+    return " ".join(node.text.split())
+
+
+def page_text(page):
+    return " ".join(Tree(page).root.text.split())
+
+
+def statewide_update(page, state, election):
+    """Check a results page's election identity and return its 'last updated' text."""
+    body = page_text(page)
+    if f"{state} Secretary of State" not in body or election not in body:
+        raise ValueError(f"{state} results page belongs to another election")
+    found = re.findall(
+        r"Results last updated: ([0-9]{1,2}/[0-9]{1,2}/2026 [0-9]{1,2}:[0-9]{2} [AP]M [A-Z]{2})",
+        body,
+    )
+    if len(set(found)) != 1:
+        raise ValueError(f"{state} results page lacks one update time")
+    return found[0]
+
+
+def export_target(page, *, link_text=None, button_value=None, race_id=None):
+    """The event target of exactly one export link or button on an official page."""
+    root = Tree(page).root
+    if link_text is not None:
+        nodes = [n for n in root.find("a") if text(n) == link_text]
+        scripts = [n.attrs.get("href", "") for n in nodes]
+    else:
+        nodes = [
+            n
+            for n in root.find("input")
+            if n.attrs.get("value") == button_value and n.attrs.get("raceid") == race_id
+        ]
+        scripts = [n.attrs.get("onclick", "") for n in nodes]
+    if len(nodes) != 1:
+        raise ValueError("Expected exactly one official export control")
+    calls = POSTBACK.findall(scripts[0])
+    match = [None, calls[0]] if len(calls) == 1 else None
+    if not match or (link_text is None and nodes[0].attrs.get("name") != match[1]):
+        raise ValueError("Export control does not post back to its own page")
+    return match[1]
+
+
+def name_key(value):
+    return " ".join(str(value).replace('"', "'").split())
+
+
+def number(value, *, unreported=False):
+    if type(value) is int:
+        return count(value)
+    if isinstance(value, str) and re.fullmatch(r"[0-9]+", value.strip()):
+        return count(int(value.strip()))
+    if unreported and isinstance(value, str) and value.strip() == "*":
+        return None
+    raise ValueError(f"Invalid county workbook count: {value!r}")
+
+
+def sheet_rows(book, sheet, race_name, *, title, state_line, unreported=False):
+    """Read one official county sheet: ({candidate: column}, {county: [values]}, totals)."""
+    rows = book.rows(sheet)
+    if not rows or not rows[0] or rows[0][0] not in title:
+        raise ValueError("County workbook belongs to another election")
+    if len(rows) < 2 or rows[1] != [state_line]:
+        raise ValueError("County workbook belongs to another state")
+    headers = [i for i, r in enumerate(rows) if len(r) > 2 and r[1] == "County"]
+    if len(headers) != 1 or name_key(rows[headers[0]][0]) != race_name:
+        raise ValueError(f"{race_name}: unexpected county workbook header")
+    header = rows[headers[0]]
+    candidates = [name_key(c) for c in header[2:]]
+    if not candidates or len(set(candidates)) != len(candidates) or "" in candidates:
+        raise ValueError(f"{race_name}: invalid county workbook candidates")
+    counties, totals, finished = {}, None, False
+    for values in rows[headers[0] + 1 :]:
+        if not any(v not in (None, "") for v in values):
+            continue
+        if finished or len(values) != len(header) or values[0] not in (None, ""):
+            raise ValueError(f"{race_name}: unexpected county workbook row")
+        label = " ".join(str(values[1] or "").split())
+        cells = [number(v, unreported=unreported) for v in values[2:]]
+        if label == "TOTALS":
+            totals, finished = cells, True
+            continue
+        county = re.sub(r" \(Vote Center\)$", "", label).upper()
+        if not county or county in counties:
+            raise ValueError(f"{race_name}: missing or duplicate county row")
+        counties[county] = cells
+    if totals is None or not counties:
+        raise ValueError(f"{race_name}: county workbook lacks its TOTALS row")
+    return candidates, counties, totals
+
+
+def county_sheet(book, sheet, race_name, official, *, title, state_line, masked=False):
+    """County votes by candidate, checked against ``official`` statewide totals.
+
+    Returns ``(counties, hidden)``. Without ``masked`` every cell must be a number and
+    both TOTALS and the county sum must equal ``official``. With ``masked`` a ``*`` cell is
+    a count the state hid for voter privacy. Such a county is left out of that race
+    entirely (``hidden``) rather than shown with a candidate missing. TOTALS must still
+    equal the sum of the printed cells, and must equal ``official`` for every candidate
+    without a hidden cell; a candidate with one may only fall short of it.
+    """
+    candidates, counties, totals = sheet_rows(
+        book, sheet, race_name, title=title, state_line=state_line, unreported=masked
+    )
+    keys = {name_key(name): name for name in official}
+    if len(keys) != len(official) or set(candidates) != set(keys):
+        raise ValueError(f"{race_name}: county workbook candidates differ from the statewide CSV")
+    names = [keys[c] for c in candidates]
+    if None in totals:
+        raise ValueError(f"{race_name}: county workbook TOTALS are not numeric")
+    sums = [sum(cells[i] or 0 for cells in counties.values()) for i in range(len(names))]
+    if sums != totals:
+        raise ValueError(f"{race_name}: county rows do not add up to the workbook TOTALS")
+    for i, name in enumerate(names):
+        if any(cells[i] is None for cells in counties.values()):
+            if totals[i] > official[name]:
+                raise ValueError(f"{race_name}: printed county votes exceed the statewide CSV")
+        elif totals[i] != official[name]:
+            raise ValueError(f"{race_name}: county workbook TOTALS differ from the statewide CSV")
+    hidden = sorted(county for county, cells in counties.items() if None in cells)
+    shown = {
+        county: dict(zip(names, cells))
+        for county, cells in counties.items()
+        if county not in hidden
+    }
+    return shown, hidden
+
+
+def find_sheet(book, prefix, race_name):
+    """The one sheet named ``prefix`` + race name, which the site truncates to 30 chars."""
+    full = prefix + race_name
+    matches = [s for s in book.sheets if s.startswith(prefix) and full.startswith(s.strip())]
+    if prefix.isdigit():
+        matches = [s for s in matches if not s[len(prefix) : len(prefix) + 1].isdigit()]
+    if len(matches) != 1 or len(matches[0]) < min(len(full), 30):
+        raise ValueError(f"{race_name}: expected one '{prefix}' county sheet")
+    return matches[0]
diff --git a/src/election_pipeline/parsers/fl.py b/src/election_pipeline/parsers/fl.py
new file mode 100644
index 0000000..7c0ce5a
--- /dev/null
+++ b/src/election_pipeline/parsers/fl.py
@@ -0,0 +1,150 @@
+"""Florida Division of Elections statewide results file (tab-delimited, one row per county).
+
+``results.txt`` is the "Download Results" text file linked from Florida Election Watch.
+It has a row per race, county and candidate, with each county's precinct counts. Florida
+publishes no separate statewide row, so each statewide total here is the sum of the
+official county rows (Florida Election Watch's statewide pages show the same sums).
+Florida does not publish vote-method (ballot type) detail in this file. District 10 was
+uncontested and is not on the ballot or in the file.
+
+Write-in candidates appear with party ``WRI`` and are kept as candidates. Governor rows
+list the governor in the first-name field and the lieutenant governor in the last-name
+field, separated by ``/``; they are shown as "Governor / Lieutenant Governor".
+"""
+
+import csv
+import io
+import re
+import zipfile
+from collections import defaultdict
+
+from election_pipeline.parsers.common import integer
+from election_pipeline.parsers.scope import verify_scope
+from election_pipeline.parsers.structured import row
+from election_pipeline.parsers.totals import database_row, finish, load_contract  # noqa: F401
+
+HEADER = (
+    "ElectionDate\tPartyCode\tPartyName\tRaceCode\tRaceName\tCountyCode\tCountyName\tJuris1num\t"
+    "Juris2num\tPrecincts\tPrecinctsReporting\tCanNameLast\tCanNameFirst\tCanNameMiddle\tCanVotes"
+).split("\t")
+
+
+def contest(values):
+    code, name, district = values["RaceCode"], values["RaceName"], values["Juris1num"]
+    if code == "USS" and name == "United States Senator" and not district:
+        return "FL-SEN"
+    if code == "GOV" and name == "Governor and Lieutenant Governor" and not district:
+        return "FL-GOV"
+    if code == "USR":
+        match = re.fullmatch(r"Representative in Congress, District ([1-9][0-9]?)", name)
+        if not match or not re.fullmatch(r"[0-9]{3}", district) or int(district) != int(match[1]):
+            raise ValueError("Florida congressional race and district disagree")
+        return f"FL-{int(match[1]):02}"
+    return None
+
+
+def candidate(values):
+    last, first, middle = (values[k] for k in ("CanNameLast", "CanNameFirst", "CanNameMiddle"))
+    if not last:
+        raise ValueError("Missing Florida candidate name")
+    if middle == "/":
+        if not first:
+            raise ValueError("Incomplete Florida ticket")
+        name = f"{first} / {last}"
+    else:
+        name = " ".join(part for part in (first, middle, last) if part)
+    identity = "|".join((values["PartyCode"], last, first, middle))
+    return identity, name
+
+
+def parse(archive_path, source, settings, output, stats, reference=None):
+    from election_pipeline.states import state_adapter
+
+    if source.format != "bundle" or source.election_date != "2026-11-03" or source.state != "FL":
+        raise ValueError("Unsupported Florida source/election")
+    wanted = state_adapter("FL").selected_races(source)
+    with zipfile.ZipFile(archive_path) as archive:
+        text = archive.read(source.primary_filename).decode("utf-8-sig")
+    reader = csv.reader(io.StringIO(text, newline=""), delimiter="\t", strict=True)
+    if next(reader, []) != HEADER:
+        raise ValueError("Unexpected Florida results header")
+    counties = defaultdict(dict)  # race -> county -> {candidate identity: votes}
+    precincts = defaultdict(dict)  # race -> county -> (reporting, total)
+    names, parties, codes, source_ids = defaultdict(dict), {}, {}, {}
+    for line, values in enumerate(reader, 2):
+        if line > settings.max_csv_rows + 1 or len(values) != len(HEADER):
+            raise ValueError("Unexpected Florida field count/row limit")
+        values = dict(zip(HEADER, (v.strip() for v in values)))
+        if values["ElectionDate"] != "11/03/2026":
+            raise ValueError("Florida file belongs to another election")
+        race = contest(values)
+        if race not in wanted:
+            continue
+        if values["Juris2num"]:
+            raise ValueError("Unexpected Florida sub-jurisdiction")
+        county = values["CountyName"].upper()
+        if not county or codes.setdefault(county, values["CountyCode"]) != values["CountyCode"]:
+            raise ValueError("Missing or inconsistent Florida county")
+        identity, name = candidate(values)
+        race_code = values["RaceCode"] + (f"-{values['Juris1num']}" if values["Juris1num"] else "")
+        if source_ids.setdefault(race, race_code) != race_code:
+            raise ValueError("Inconsistent Florida race code")
+        reporting = integer(values["PrecinctsReporting"], "precincts reporting")
+        total = integer(values["Precincts"], "precincts")
+        if reporting > total:
+            raise ValueError("Florida reporting precincts exceed total")
+        if precincts[race].setdefault(county, (reporting, total)) != (reporting, total):
+            raise ValueError("Florida county precinct counts differ between candidates")
+        if identity in counties[race].get(county, {}):
+            raise ValueError("Duplicate Florida candidate row")
+        if (
+            names[race].setdefault(identity, name) != name
+            or parties.setdefault(identity, values["PartyCode"]) != values["PartyCode"]
+        ):
+            raise ValueError("Inconsistent Florida candidate identity")
+        counties[race].setdefault(county, {})[identity] = integer(values["CanVotes"], "votes")
+    if set(counties) != set(wanted):
+        raise ValueError("Florida file lacks a selected race")
+    rows = []
+    for race in sorted(counties):
+        candidates = set(names[race])
+        for county, votes in counties[race].items():
+            if set(votes) != candidates:
+                raise ValueError(f"{race}: {county} lacks a candidate row")
+        verify_scope("FL", race, sorted(candidates), list(counties[race]))
+        reporting = sum(p[0] for p in precincts[race].values())
+        total = sum(p[1] for p in precincts[race].values())
+        for identity in sorted(candidates):
+            rows.append(
+                row(
+                    race,
+                    source_ids[race],
+                    identity,
+                    names[race][identity],
+                    parties[identity],
+                    sum(v[identity] for v in counties[race].values()),
+                    reporting=reporting,
+                    total=total,
+                )
+            )
+        for county in sorted(counties[race]):
+            reporting, total = precincts[race][county]
+            for identity in sorted(candidates):
+                rows.append(
+                    row(
+                        race,
+                        source_ids[race],
+                        identity,
+                        names[race][identity],
+                        parties[identity],
+                        counties[race][county][identity],
+                        county=county,
+                        reporting=reporting,
+                        total=total,
+                    )
+                )
+    finish(rows, source, settings, output, stats, reference=reference)
+    stats.update(
+        statewide_totals="sum_of_official_county_rows",
+        vote_methods="not_published",
+    )
diff --git a/src/election_pipeline/parsers/nm.py b/src/election_pipeline/parsers/nm.py

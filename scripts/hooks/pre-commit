#!/bin/sh
# Refuse a commit that adds a public IP address, an S3 bucket, an AWS ARN with an account
# ID or an access key ID (scripts/check_public_values.py), before it can reach the public
# repository. CI runs the same check over every file, but only after a push.
#
# Install once per clone:   git config core.hooksPath scripts/hooks
root=$(git rev-parse --show-toplevel)
for python in "$root/.venv/Scripts/python.exe" "$root/.venv/bin/python" python3 python; do
    if command -v "$python" >/dev/null 2>&1 && "$python" -c "" >/dev/null 2>&1; then
        exec "$python" "$root/scripts/check_public_values.py" --staged
    fi
done
if command -v py >/dev/null 2>&1; then
    exec py -3 "$root/scripts/check_public_values.py" --staged
fi
echo "pre-commit: no Python found to run scripts/check_public_values.py; commit refused." >&2
exit 1

*.sh text eol=lf
scripts/hooks/* text eol=lf
*.service text eol=lf
*.timer text eol=lf
Dockerfile text eol=lf

# Preserve captured official bytes across Windows/Linux checkouts.
tests/fixtures/expansion/*.txt -text whitespace=-blank-at-eol
tests/fixtures/expansion/*.csv -text whitespace=-blank-at-eol
tests/fixtures/mississippi/*.html -text whitespace=-blank-at-eol
tests/fixtures/illinois/*.html -text whitespace=-blank-at-eol
tests/fixtures/illinois/gbs_*.json -text whitespace=-blank-at-eol
tests/fixtures/illinois/ev_*.json -text whitespace=-blank-at-eol
# These resources are pinned by their exact bytes, including line endings.
src/election_pipeline/resources/alaska-issuers.pem text eol=lf
src/election_pipeline/resources/florida-root.pem text eol=lf
config/elections/*/tables/ak-scope.json text eol=lf
config/elections/*/tables/ms-counties.json text eol=lf
config/elections/*/tables/ms-house.json text eol=lf
tests/fixtures/alaska/official/* -text whitespace=-blank-at-eol

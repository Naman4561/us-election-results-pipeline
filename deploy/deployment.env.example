# This file contains paths and resource budgets, not database passwords.
PRODUCTION_ENV=/etc/election-pipeline/production.env
CATALOG_FILE=/var/lib/election-pipeline-deployment/catalog.json
CONTROL_STATE_DIR=/var/lib/election-pipeline-deployment
# The systemd units run scripts from this symlink; `deploy.py release` repoints it.
CURRENT_RELEASE=/opt/election-releases/current
DOCKER_NETWORK=election-production_default
# The Caddyfile the running Caddy container mounts; dashboard switches rewrite it in place.
CADDYFILE=/opt/election-pipeline/deploy/Caddyfile
# Obtain with: docker ps --filter name=caddy --format '{{.ID}}'
CADDY_CONTAINER=REPLACE_WITH_RUNNING_CADDY_CONTAINER_ID
ORIGIN_URL=http://127.0.0.1
# Measure free memory and Docker usage before setting these two values.
# Every job and dashboard container uses these per-container limits.
JOB_CPUS=0.5
JOB_MEMORY=768m
JOB_TIMEOUT=240
CYCLE_SECONDS=270
# Jobs run at once (1-4), each with the limits above. Raise only after measuring
# headroom: the host also runs PostgreSQL and the dashboard.
JOB_PARALLEL=1

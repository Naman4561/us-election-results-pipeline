# This file contains paths/resource budgets, not database passwords.
BASELINE_ROOT=/opt/election-pipeline
# Set to the NEW immutable checkout containing these deployment controls.
CONTROL_ROOT=/opt/election-releases/REPLACE_WITH_CONTROL_COMMIT
PRODUCTION_ENV=/etc/election-pipeline/production.env
CATALOG_FILE=/var/lib/election-pipeline-deployment/catalog.json
CONTROL_STATE_DIR=/var/lib/election-pipeline-deployment
DOCKER_NETWORK=election-production_default
CADDYFILE=/opt/election-pipeline/deploy/Caddyfile
# Obtain with: docker compose --env-file /etc/election-pipeline/production.env -f
# /opt/election-pipeline/compose.production.yml --profile public ps -q caddy
CADDY_CONTAINER=REPLACE_WITH_RUNNING_CADDY_CONTAINER_ID
ORIGIN_URL=http://127.0.0.1
# Measure free memory and Docker usage before setting these two values.
# Both worker and candidate dashboard containers use these per-container limits.
EXPANSION_CPUS=0.5
EXPANSION_MEMORY=768m
JOB_TIMEOUT=240
CYCLE_SECONDS=270
# Expansion jobs run at once (1-4), each with the limits above. Raise only after
# measuring headroom: the host also serves the baseline collector and PostgreSQL.
EXPANSION_PARALLEL=1

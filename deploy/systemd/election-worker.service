[Unit]
Description=Collect and publish every enabled election results source
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target
OnFailure=election-monitor.service

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/election-releases/current
UMask=0077
Nice=10
ExecStart=/opt/election-releases/current/.venv/bin/python scripts/deploy.py run
TimeoutStartSec=6min

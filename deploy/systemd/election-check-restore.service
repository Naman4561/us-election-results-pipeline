[Unit]
Description=Restore the newest uploaded backup into a temporary database and verify it
Requires=docker.service
After=docker.service network-online.target election-backup.service
Wants=network-online.target
OnFailure=election-monitor.service

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/election-releases/current
UMask=0077
Nice=10
ExecStart=/opt/election-releases/current/.venv/bin/python scripts/production_recovery.py check-restore --catalog-file /var/lib/election-pipeline-deployment/catalog.json
# About 20 minutes when the host is quiet.
TimeoutStartSec=60min

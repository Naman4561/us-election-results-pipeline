[Unit]
Description=Upload an election backup and retain one uploaded local bundle
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=3
OnFailure=election-monitor.service
# A state promoted since the last check is now in a backup: verify it restores (the check
# exits at once when no state awaits one).
OnSuccess=election-check-restore.service

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/election-releases/current
UMask=0077
Nice=10
ExecStart=/opt/election-releases/current/.venv/bin/python scripts/production_recovery.py backup --catalog-file /var/lib/election-pipeline-deployment/catalog.json
ExecStartPost=/opt/election-releases/current/.venv/bin/python scripts/prune_backups.py --keep 1 --apply
Restart=on-failure
RestartSec=30s
# Up to 10 min waiting for running jobs, then about 30 min of copying and the dump.
TimeoutStartSec=60min
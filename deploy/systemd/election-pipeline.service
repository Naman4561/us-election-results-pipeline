[Unit]
Description=Collect and publish configured election result sources
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target
OnFailure=election-monitor.service

[Service]
Type=oneshot
WorkingDirectory=/opt/election-pipeline
ExecStart=/usr/bin/docker compose --env-file /etc/election-pipeline/production.env -f compose.production.yml --profile tools run --rm --no-deps -T --name election-production-pipeline-job pipeline
ExecStopPost=-/usr/bin/docker rm -f election-production-pipeline-job
TimeoutStartSec=25min
# The first `deploy.py activate` replaces the placeholder upstream below; every later
# dashboard switch rewrites all three upstreams together.
{$SITE_DOMAIN} {
    encode zstd gzip
    # Viewers reach the site over HTTPS at the CDN, which passes this header on. One year,
    # raised the evening of Nov 24, 2026 after max-age=86400 caused no trouble.
    header >Strict-Transport-Security "max-age=31536000"

    @unsupported not method GET HEAD
    @assets path /*.js /*.css /*-map.json

    route {
        respond @unsupported "Method not allowed" 405

        handle /api/* {
            header >Cache-Control "no-store"
            reverse_proxy election-dashboard-not-activated:8000
        }

        handle @assets {
            header Cache-Control "public, max-age=300" {
                match status 2xx
            }
            reverse_proxy election-dashboard-not-activated:8000
        }

        handle {
            header >Cache-Control "no-cache"
            reverse_proxy election-dashboard-not-activated:8000
        }
    }

    log {
        output stdout
        format json
    }
}
+Hancock is the real case: its official PDF is behind a firewall that blocks the production
+host. The pipeline never tries to get past the block; a person supplies the official file,
+the county's own parser must read it, and the reviewer's transcription must match.
+"""
+
+import hashlib
+import json
+import unittest
+from unittest.mock import patch
+
+import test_mississippi as fixtures
+
+from election_pipeline.collectors import county_files
+from election_pipeline.county_import import import_county, write_template
+from election_pipeline.parsers import ms
+from election_pipeline.pipeline import collect_source
+
+BLOCKED = {"HANCOCK": 403}
+
+
+class BlockedAutomaticCountyTests(unittest.TestCase):
+    def setUp(self):
+        self.f = fixtures.MississippiTests()
+        self.f.setUp()
+        self.addCleanup(self.f.doCleanups)
+        self.county = self.f.counties["HANCOCK"]
+        self.raw = self.f.raw["HANCOCK"]
+
+    def review(self, **changes):
+        value = dict(
+            state="MS",
+            county="HANCOCK",
+            election_date="2026-11-03",
+            contest_id="MS-SEN",
+            raw_sha256=hashlib.sha256(self.raw).hexdigest(),
+            source_url=self.county["url"],
+            official_page_url="https://www.hancockcounty.ms.gov/DocumentCenter/Index/164",
+            observed_at="2026-11-04T06:00:00+00:00",
+            reviewed_by="TEST FIXTURE: values from tests/test_mississippi.py EXPECTED",
+            countywide_report_confirmed=True,
+            report_generated_at="2026-11-03T21:31:00-06:00",
+            report_date="2026-11-03",
+            report_time_note=None,
+            counts=dict(zip(self.f.policy["candidates"], fixtures.EXPECTED["HANCOCK"])),
+            write_in_votes=28,
+            write_in_label="Write-In Totals",
+            reported_candidate_vote_total=16760,
+            precincts_reporting=26,
+            precincts_total=26,
+            absentee_scope="unspecified",
+            affidavit_scope="unspecified",
+        )
+        value.update(changes)
+        return value
+
+    def collect(self, failures):
+        with patch.object(
+            county_files, "fetch_file", side_effect=self.f.fetcher(failures=failures)
+        ):
+            return collect_source(self.f.source, self.f.settings, self.f.root, force_download=True)
+
+    def importing(self, review, raw=None):
+        original, review_path = self.f.root / "hancock.pdf", self.f.root / "hancock.json"
+        original.write_bytes(self.raw if raw is None else raw)
+        review_path.write_text(json.dumps(review), encoding="utf-8")
+        with patch.object(county_files, "fetch_file", side_effect=AssertionError("import HTTP")):
+            return import_county(
+                self.f.source, self.f.settings, self.f.root, "HANCOCK", original, review_path
+            )
+
+    def latest(self):
+        return ms.read_bundle(self.f.store.cached_archive(self.f.store.read_state()), self.f.source)
+
+    def test_blocked_county_imports_and_stays_manual_until_the_url_works(self):
+        self.collect(BLOCKED)
+        _, manifest, accepted = self.latest()
+        self.assertEqual(manifest["counties"]["HANCOCK"]["status"], "unavailable")
+        self.assertNotIn("HANCOCK", accepted)
+
+        review = self.review()
+        self.assertEqual(self.importing(review)["outcome"], "manual_imported")
+        _, manifest, accepted = self.latest()
+        record = manifest["counties"]["HANCOCK"]
+        self.assertEqual((record["status"], record["issue"]), ("stale", "ManualSnapshot"))
+        self.assertEqual(accepted["HANCOCK"][2]["counts"], review["counts"])
+
+        # Still blocked: the snapshot is kept, labelled manual, and the block is recorded.
+        self.collect(BLOCKED)
+        _, manifest, accepted = self.latest()
+        record = manifest["counties"]["HANCOCK"]
+        self.assertEqual(record["issue"], "ManualSnapshot")
+        self.assertIn("HTTP 403", record["automatic_issue"])
+        self.assertEqual(record["last_success_at"], review["observed_at"])
+        self.assertIn("HANCOCK", accepted)
+
+        # Once the URL answers, real automatic bytes replace the review.
+        self.collect({})
+        _, manifest, _ = self.latest()
+        record = manifest["counties"]["HANCOCK"]
+        self.assertEqual((record["status"], record["issue"]), ("current", None))
+        self.assertNotIn("review", record)
+
+        with self.assertRaisesRegex(ValueError, "Automatic collection is current"):
+            self.importing(self.review(observed_at="2026-11-04T07:00:00+00:00"))
+
+    def test_review_must_match_the_county_parser(self):
+        self.collect(BLOCKED)
+        names = self.f.policy["candidates"]
+        swapped = dict(zip(names, (11441, 4538, 753)))  # reconciles, but wrong candidates
+        with self.assertRaisesRegex(ValueError, "disagrees with the county parser: counts"):
+            self.importing(self.review(counts=swapped))
+        with self.assertRaisesRegex(ValueError, "precincts_reporting"):
+            self.importing(self.review(precincts_reporting=25))
+        with self.assertRaisesRegex(ValueError, "report_generated_at"):
+            self.importing(self.review(report_generated_at="2026-11-03T20:31:00-06:00"))
+
+    def test_only_the_configured_url_and_the_countys_own_report_are_accepted(self):
+        self.collect(BLOCKED)
+        with self.assertRaisesRegex(ValueError, "configured URL"):
+            self.importing(
+                self.review(source_url="https://www.hancockcounty.ms.gov/DocumentCenter/View/1/x")
+            )
+        hinds = self.f.raw["HINDS"]
+        with self.assertRaises(ValueError):
+            self.importing(self.review(raw_sha256=hashlib.sha256(hinds).hexdigest()), raw=hinds)
+        _, manifest, accepted = self.latest()
+        self.assertNotIn("HANCOCK", accepted)
+        self.assertEqual(manifest["counties"]["HANCOCK"]["status"], "unavailable")
+
+    def test_template_names_the_configured_url_and_leaves_counts_for_the_reviewer(self):
+        original, template = self.f.root / "hancock.pdf", self.f.root / "hancock-review.json"
+        original.write_bytes(self.raw)
+        write_template(self.f.source, "HANCOCK", original, template)
+        value = json.loads(template.read_text(encoding="utf-8"))
+        self.assertEqual(value["source_url"], self.county["url"])
+        self.assertTrue(all(v is None for v in value["counts"].values()))
+
+
+if __name__ == "__main__":
+    unittest.main()
